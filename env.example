# VodiWalker Professional 17
ADMIN_USERNAME=VodiAdmin
ADMIN_PASSWORD=change-me-now
SECRET_KEY=
PORT=8000
RAILWAY_VOLUME_MOUNT_PATH=./data
PUBLIC_BASE_URL=
TCP_PUBLIC_HOST=
TCP_PUBLIC_PORT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=VodiWalkerBot

# ---- KataBump / هاست‌های بدون SSL (IP:PORT) ----
# آدرس پنل با پورت. مثال: http://1.2.3.4:25565
# اگر خالی بماند، آدرس و پورت از خود درخواست مرورگر خوانده می‌شود.
# PUBLIC_BASE_URL=http://1.2.3.4:25565
# VW_TLS=0            # کانفیگ‌ها بدون TLS ساخته شوند (روی http)
# VW_FORCE_PORT=25565 # پورت داخل کانفیگ‌ها = پورت پنل
# VODIWALKER_SALES_PORT=25565

# ---- v18: پروکسی تلگرام ----
# پورت MTProto (باید روی هاست باز و از بیرون در دسترس باشد؛ از داخل پنل هم قابل تغییر است)
TG_PROXY_PORT=8443
# پورت SOCKS5 مخصوص تلگرام (0 = خاموش)
TG_SOCKS_PORT=0
# آدرس عمومی سرور برای لینک‌ها (خالی = آدرس پنل)
TG_PUBLIC_HOST=
